# Copy these values into the Streamlit Community Cloud secrets editor.
# Never rename this file to secrets.toml and commit a real key.
OPENAI_API_KEY = "sk-project-replace-with-your-key"
OPENAI_MODEL = "gpt-5.6-luna"
OPENAI_ALLOWED_EMAILS = ["you@example.com", "partner@example.com"]
OPENAI_MAX_CALLS_PER_SESSION = 10
